# Endpoint del formulario de acceso anticipado.
# Crea un formulario en https://formspree.io y pega aquí su URL completa.
# Sin esta variable el formulario falla al enviar y muestra el aviso de error
# genérico. El visitante nunca ve el nombre de la variable.
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/TU_ID_DE_FORMULARIO

# Dominio público del sitio. Alimenta sitemap.xml y robots.txt.
NEXT_PUBLIC_SITE_URL=https://thecarriers.mx
