# Endpoint del formulario de acceso anticipado: la URL /exec de la aplicación
# web de Apps Script (instrucciones en docs/formulario-google.gs) o la de un
# formulario de https://formspree.io.
# Sin esta variable el formulario falla al enviar y muestra el aviso de error
# genérico. El visitante nunca ve el nombre de la variable.
NEXT_PUBLIC_FORM_ENDPOINT=https://script.google.com/macros/s/TU_ID/exec

# Dominio público del sitio. Alimenta sitemap.xml y robots.txt.
NEXT_PUBLIC_SITE_URL=https://thecarriers.com.mx
